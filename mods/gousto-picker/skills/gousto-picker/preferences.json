      "red wine",
      "balsamic",
      "feta",
      "cucumber",
      "apple",
      "banana",
      "chickpea",
      "pulse beans"
    ],
    "stage1": "title match raises a flag only",
    "stage2": "ingredient line match, then usage verdict",
    "usageVerdict": {
      "values": [
        "separable",
        "structural",
        "unclear"
      ],
      "evidence": [
        "title",
        "ingredient line form (paste, vinegar, sauce, stock, compound mix)",
        "photo"
      ],
      "structuralExcludedFromTop10": true,
      "listExcludedForOverride": true
    }
  },
  "spice": {
