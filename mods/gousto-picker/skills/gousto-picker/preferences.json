      "min": 30,
      "noExtraBenefitAbove": 40
    },
    "fibreG": {
      "min": 7
    },
    "sugarsG": {
      "ideal": 10,
      "note": "added sugar should weigh more than intrinsic; the data does not separate them"
    }
  },
  "stage1": {
    "excludeDietaryTags": [
      "vegetarian",
      "plantBased"
    ],
    "excludeDietaryTags_note": "[assumed] none of your past baskets were vegetarian; remove to include them",
    "maxPerProteinType": 10,
    "maxPerProteinType_note": "[assumed] stops a chicken-heavy menu filling all 20 slots",
    "ranking": "protein per 100 kcal, minus 0.03 per cook minute, minus penalties for protein under 30 g",
    "maxCookMins": 60,
    "maxCookMins_note": "[assumed] recipes over this are skipped"
  },
  "hardDrop": {
    "ingredientTerms": [
      "prawn"
    ],
    "appliesAt": "stage2"
  },
